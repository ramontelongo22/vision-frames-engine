# Vision Frames engine - server-side configuration. Never commit real keys.
# Only the local runner's --live mode reads these; tests and --mock need none.

# Image generation and refinement (Google Gemini API, "Nano Banana")
GEMINI_API_KEY=

# QA analysis and optional semantic normalization (OpenAI API)
OPENAI_API_KEY=

# Optional overrides. Defaults were checked against provider docs on 2026-10-28
# (docs/DECISIONS.md P-10); provider model ids change, so re-check before relying on them.
# VF_GEMINI_IMAGE_MODEL=gemini-3-pro-image
# VF_OPENAI_ANALYSIS_MODEL=gpt-6-astra
# VF_OPENAI_NORMALIZER_MODEL=gpt-6-astra

# Frames are 16:9 by default (owner decision, docs/DECISIONS.md V2-02); size is left to the provider.
# VF_GEMINI_ASPECT_RATIO=16:9
# VF_GEMINI_IMAGE_SIZE=1K
